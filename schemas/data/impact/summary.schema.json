{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/schemas/data/impact/summary.schema.json",
  "title": "Impact summary",
  "description": "Snapshot of Data services impact figures for /services/impact/. Country outlines in paths are Natural Earth 110m (public domain), as SVG path data in a 0 0 1000 520 view box. Fills are not stored.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "data_date",
    "window_start",
    "window_end",
    "interactions",
    "highlights",
    "countries_all_time",
    "countries_last_12m",
    "repository_countries",
    "serve_countries",
    "by_country",
    "paths"
  ],
  "properties": {
    "data_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Date of the extract, shown as data as of."
    },
    "window_start": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "First day of the last-12-months window."
    },
    "window_end": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Last day of the last-12-months window."
    },
    "interactions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["last_12m", "all_time"],
      "properties": {
        "last_12m": { "$ref": "#/$defs/interaction_totals" },
        "all_time": { "$ref": "#/$defs/interaction_totals" }
      }
    },
    "highlights": {
      "type": "array",
      "minItems": 1,
      "description": "Tiles in display order. Omit a tile that has no figure.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "value", "label"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9_]+$"
          },
          "value": {
            "type": "number",
            "minimum": 0
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "description": "Shown after the value, for example PB or TB."
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "countries_all_time": {
      "type": "integer",
      "minimum": 0
    },
    "countries_last_12m": {
      "type": "integer",
      "minimum": 0
    },
    "repository_countries": {
      "type": "integer",
      "minimum": 0
    },
    "serve_countries": {
      "type": "integer",
      "minimum": 0
    },
    "by_country": {
      "type": "array",
      "minItems": 1,
      "description": "Countries with an alpha-3 code and a positive all-time interaction total.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["alpha3", "name", "interactions"],
        "properties": {
          "alpha3": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "interactions": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "paths": {
      "type": "array",
      "minItems": 1,
      "description": "One Natural Earth 110m outline per country. Draw in a 0 0 1000 520 view box. Colour from by_country; countries with no interactions stay grey.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["a3", "name", "d"],
        "properties": {
          "a3": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "d": {
            "type": "string",
            "minLength": 1,
            "description": "SVG path data."
          }
        }
      }
    }
  },
  "$defs": {
    "interaction_totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "downloads", "views", "visits"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "downloads": { "type": "integer", "minimum": 0 },
        "views": { "type": "integer", "minimum": 0 },
        "visits": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
